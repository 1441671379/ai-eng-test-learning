{
  "name": "english-learning-web",
  "version": "0.1.0",
  "description": "本地英语学习空间：听、说、读、写与单词",
  "license": "MIT",
  "private": true,
  "keywords": [
    "nextjs",
    "typescript",
    "pronunciation",
    "accent-training",
    "speech",
    "ai",
    "education",
    "supabase",
    "language-learning",
    "text-to-speech",
    "speech-recognition"
  ],
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:all": "node ./scripts/dev-all.mjs",
    "serve": "node ./scripts/serve.mjs",
    "build": "next build",
    "start": "node ./scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "db:cloud": "node ./scripts/db-cloud.mjs",
    "db:cloud:clear": "node ./scripts/db-cloud.mjs --clear",
    "db:cloud:clear-force": "node ./scripts/db-cloud.mjs --clear-force",
    "db:cloud:reset": "node ./scripts/db-cloud.mjs --reset",
    "db:cloud:reset-force": "node ./scripts/db-cloud.mjs --reset --clear-force",
    "db:cloud:modules": "npx supabase db query -f supabase/modules.sql --linked",
    "db:cloud:conversation": "npx supabase db query -f supabase/conversation.sql --linked",
    "test": "node --test --import ./tests/register.mjs \"tests/**/*.test.ts\"",
    "prebuild": "node ./scripts/build-ui-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "griddy-icons": "^0.2.0",
    "lenis": "^1.3.21",
    "next": "16.2.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
