# Copy these entries into apps/web/.env.local, or set the server process environment.
# Never use NEXT_PUBLIC_ for credentials. Restart the web service after changes.
ENGLISH_TENCENT_SOE_SECRET_ID=
ENGLISH_TENCENT_SOE_SECRET_KEY=
# Required account AppID for WebSocket (not the business SoeAppId).
ENGLISH_TENCENT_SOE_ACCOUNT_APP_ID=
# Match Tencent's Go speech workbench. Use http only for the legacy SOE Basic API.
ENGLISH_TENCENT_SOE_PROTOCOL=websocket
# Optional temporary-credential token. Leave empty for permanent credentials.
ENGLISH_TENCENT_SOE_TOKEN=
# Optional SOE Basic HTTP business id; this is NOT the Tencent account AppID.
ENGLISH_TENCENT_SOE_APP_ID=
# Adult strictness, valid range 1–4.
ENGLISH_TENCENT_SOE_SCORE_COEFF=4
